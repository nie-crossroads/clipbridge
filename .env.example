# ClipBridge local development database. Copy to .env and set your password.
# These names are the configuration contract for the future Go service.
CLIPBRIDGE_DB_HOST=127.0.0.1
CLIPBRIDGE_DB_PORT=3306
CLIPBRIDGE_DB_NAME=clipbridge
CLIPBRIDGE_DB_USER=root
CLIPBRIDGE_DB_PASSWORD=replace-with-local-password
CLIPBRIDGE_DB_TLS=false
