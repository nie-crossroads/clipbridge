# ClipBridge local development configuration.
CLIPBRIDGE_ADDR=127.0.0.1:8080
# Set false only for local HTTP on a loopback address.
CLIPBRIDGE_SECURE_COOKIE=true
CLIPBRIDGE_DB_HOST=127.0.0.1
CLIPBRIDGE_DB_PORT=3306
CLIPBRIDGE_DB_NAME=clipbridge
CLIPBRIDGE_DB_USER=root
CLIPBRIDGE_DB_PASSWORD=replace-with-local-password
CLIPBRIDGE_DB_TLS=false

# Optional local-only password sync for an existing active admin on service startup.
# CLIPBRIDGE_LOCAL_ADMIN_USERNAME=
# CLIPBRIDGE_LOCAL_ADMIN_PASSWORD=
